# ============================================================
# ORA AI — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ATTENTION : ne jamais commiter .env.local sur GitHub
# ============================================================

# ——— CLAUDE AI (obligatoire pour Hina et les agents IA) ———
# Obtenir sur : https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ——— SUPABASE (obligatoire pour l'auth et la base de données) ———
# Obtenir sur : https://supabase.com → votre projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ——— STRIPE (pour les paiements et abonnements) ———
# Obtenir sur : https://dashboard.stripe.com → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Créer les produits/prix dans Stripe et copier les Price IDs
STRIPE_PRICE_STARTER=price_starter_...
STRIPE_PRICE_PRO=price_pro_...
STRIPE_PRICE_BUSINESS=price_business_...
# URL de votre application (ex: https://ora-ai.vercel.app en prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ——— META WHATSAPP CLOUD API (GRATUIT — 1 000 conversations/mois) ———
# Étapes : developers.facebook.com → Créer une app → WhatsApp → Business
# 1. Token d'accès (valable 24h pour les tests, générer un token permanent pour la prod)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# 2. Votre propre mot secret — recopiez-le exactement dans le portail Meta Developer
WHATSAPP_VERIFY_TOKEN=ora-ai-webhook-secret
# 3. Phone Number ID depuis le tableau de bord Meta WhatsApp
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ——— CONFIGURATION DE VOTRE ENTREPRISE ———
# Ces variables personnalisent les réponses de l'agent Hina
BUSINESS_NAME=Mon Entreprise Tahiti
BUSINESS_TYPE=boutique / restaurant / hôtel / salon de beauté / autre
BUSINESS_HOURS=Lun-Ven 8h-17h, Sam 8h-12h
BUSINESS_PHONE=+689 87 00 00 00
BUSINESS_ADDRESS=Papeete, Tahiti, Polynésie française
BUSINESS_SERVICES=Décrivez vos services ici (ex: vente de produits locaux, restauration, hébergement...)
