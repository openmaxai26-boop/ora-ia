# ==============================================================
# ORA AI — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais commiter .env.local (déjà dans .gitignore)
# ==============================================================

# --------------------------------------------------------------
# SUPABASE — Base de données & Auth
# Dashboard : https://supabase.com/dashboard/project/YOUR_PROJECT
# --------------------------------------------------------------

# URL publique du projet Supabase (visible dans Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon publique (visible dans Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — JAMAIS exposée côté client
# (visible dans Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (pour vérification des tokens côté serveur)
# Visible dans Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --------------------------------------------------------------
# NEXTAUTH / AUTH (si utilisation de NextAuth.js)
# --------------------------------------------------------------
NEXTAUTH_SECRET=your-random-secret-here-minimum-32-chars
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------
# ANTHROPIC — Claude API (IA des agents)
# Dashboard : https://console.anthropic.com/
# --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modèle par défaut (claude-3-5-haiku = rapide/économique, claude-3-5-sonnet = qualité max)
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022

# Nombre max de tokens par requête (défaut: 2048)
ANTHROPIC_MAX_TOKENS=2048

# --------------------------------------------------------------
# WHATSAPP CLOUD API (Meta for Developers)
# Dashboard : https://developers.facebook.com/apps/
# --------------------------------------------------------------

# Token d'accès permanent de l'application WhatsApp Business
WHATSAPP_ACCESS_TOKEN=EAABs...

# ID du numéro de téléphone WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token de vérification du webhook (chaîne aléatoire que vous définissez)
WHATSAPP_VERIFY_TOKEN=ora_ai_webhook_verify_token_2026

# ID du compte WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345

# --------------------------------------------------------------
# MESSENGER / FACEBOOK (Meta for Developers)
# Dashboard : https://developers.facebook.com/apps/
# --------------------------------------------------------------

# Token d'accès de la page Facebook (permanent)
MESSENGER_PAGE_ACCESS_TOKEN=EAABs...

# App Secret Facebook (pour vérification signature HMAC)
MESSENGER_APP_SECRET=abcdef1234567890abcdef1234567890

# Token de vérification du webhook Messenger
MESSENGER_VERIFY_TOKEN=ora_ai_messenger_verify_token_2026

# ID de la page Facebook
FACEBOOK_PAGE_ID=123456789012345

# --------------------------------------------------------------
# OPENAI (optionnel — alternative à Claude pour certains agents)
# Dashboard : https://platform.openai.com/
# --------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...

# --------------------------------------------------------------
# LINKEDIN (Agent Manu + Ari)
# Dashboard : https://www.linkedin.com/developers/apps
# --------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=AQX...
LINKEDIN_CLIENT_ID=86abcdefghij
LINKEDIN_CLIENT_SECRET=AbCdEfGhIjKlMnOp
LINKEDIN_ORGANIZATION_ID=123456789

# --------------------------------------------------------------
# INSTAGRAM / FACEBOOK GRAPH (Agent Teva)
# --------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=EAABs...
INSTAGRAM_BUSINESS_ACCOUNT_ID=123456789012345

# --------------------------------------------------------------
# WORDPRESS REST API (Agent Reva)
# --------------------------------------------------------------

# URL de base du site WordPress (sans slash final)
WP_ENDPOINT=https://votre-site.com/wp-json/wp/v2

# Identifiant WordPress
WP_USERNAME=admin

# Mot de passe d'application WordPress (généré dans Profil > Mots de passe d'application)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --------------------------------------------------------------
# WIX CMS API (Agent Reva — alternative WordPress)
# Dashboard : https://manage.wix.com/
# --------------------------------------------------------------
WIX_API_KEY=IST.eyJ...
WIX_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --------------------------------------------------------------
# GOOGLE APIs (Agenda, Search Console)
# Dashboard : https://console.cloud.google.com/
# --------------------------------------------------------------

# Fichier JSON du compte de service Google (stringifié en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50...

# ID du calendrier Google (agent Manu — entretiens)
GOOGLE_CALENDAR_ID=primary

# URL du site pour Google Search Console (agent Reva)
GOOGLE_SEARCH_CONSOLE_SITE=https://votre-site.com

# --------------------------------------------------------------
# NOTION CRM (Agent Ari)
# Dashboard : https://www.notion.so/my-integrations
# --------------------------------------------------------------
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROSPECTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# STRIPE — Paiements & Abonnements
# Dashboard : https://dashboard.stripe.com/
# --------------------------------------------------------------

# Clé publique (visible côté client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Clé secrète (JAMAIS côté client)
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret (pour vérifier les événements Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs des produits/prix Stripe
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ID du portail client Stripe (pour gérer abonnements)
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# RESEND — Emails transactionnels
# Dashboard : https://resend.com/
# --------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@ora-ai.pf

# --------------------------------------------------------------
# APIFY — Scraping Instagram (Agent Ari)
# Dashboard : https://console.apify.com/
# --------------------------------------------------------------
# APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# VERCEL — Déploiement
# Dashboard : https://vercel.com/dashboard
# Configurer ces variables dans Vercel > Project > Settings > Environment Variables
# --------------------------------------------------------------

# URL de production (définie automatiquement par Vercel en déploiement)
# VERCEL_URL=ora-ai.vercel.app
# Ou votre domaine personnalisé :
NEXT_PUBLIC_APP_URL=https://ora-ai.pf

# Token Vercel (pour déploiements depuis CI/CD — optionnel)
# VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID du projet Vercel (visible dans Project Settings)
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de l'équipe/organisation Vercel (si applicable)
# VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# APP — Configuration générale
# --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Ora AI
NODE_ENV=development

# Mode maintenance (true = page maintenance affichée)
# NEXT_PUBLIC_MAINTENANCE_MODE=false

# Analytics (optionnel — Vercel Analytics intégré automatiquement)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
